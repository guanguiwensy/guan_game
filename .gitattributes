# Normalize line endings: store LF in the repo, so CI (Linux) and Windows agree.
* text=auto eol=lf

# Godot / code text files are LF
*.gd     text eol=lf
*.tres   text eol=lf
*.tscn   text eol=lf
*.godot  text eol=lf
*.cfg    text eol=lf
*.import text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.sh     text eol=lf
*.uid    text eol=lf

# Binary assets — never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ogg  binary
*.wav  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
